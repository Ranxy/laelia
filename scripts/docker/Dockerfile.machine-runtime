# syntax=docker/dockerfile:1
# The machine RUNTIME image (design §8.4): the environment of the machine
# image (node, python, toolchain, common CLI utilities, codex CLI) with NO
# laelia binary baked in — the pod's init container downloads laelia-machine
# from the manager onto the data volume and seeds the credential; this
# entrypoint merely maps env → flags and execs that binary.
#
# Image contract (design §8.3) for any runtime image, not just this reference:
# POSIX sh, curl, gzip, sha256sum, gunzip. Enterprises typically
# `FROM laelia/machine-runtime` and add their own tools.
#
# Build context must be the repo root (.) so the entrypoint script can be
# copied in. There is no build stage: this image compiles nothing.

FROM node:24.12.0-slim
ARG VERSION=local
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ARG APT_MIRROR
# Codex CLI version spec for the codex ACP v2 provider (npm package). Pin a
# version for reproducible rebuilds; override with CODEX_NPM_SPEC. Keep in
# sync with Dockerfile.machine.
ARG CODEX_NPM_SPEC=@openai/codex@0.146.0
LABEL org.opencontainers.image.version=${VERSION}
LABEL org.opencontainers.image.revision=${GIT_COMMIT}
LABEL org.opencontainers.image.created=${BUILD_TIME}
# Same runtime package set as Dockerfile.machine (minus nothing — the machine
# build stage never contributed runtime packages). Do NOT apt-install bash:
# node slim images strip man pages and Debian's bash postinst fails on the
# missing bash-builtins.7.gz alternative (bash itself is in the base image).
# APT_MIRROR (e.g. http://mirrors.aliyun.com/debian) swaps the Debian repo for
# a faster local mirror; it never leaks proxy settings into the image.
RUN if [ -n "${APT_MIRROR}" ]; then \
		sed -i "s|https\?://deb.debian.org/debian|${APT_MIRROR}|g" \
			/etc/apt/sources.list.d/debian.sources /etc/apt/sources.list 2>/dev/null || true; \
	fi \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends \
		ca-certificates curl git jq wget unzip zip xz-utils ripgrep \
		python3 python3-pip python3-venv python-is-python3 build-essential \
	&& rm -rf /var/lib/apt/lists/* \
	&& useradd --create-home --uid 1001 laelia \
	&& mkdir -p /data /data/bin /data/laelia \
	&& chown -R 1001:1001 /data
# Codex ACP v2 provider: the codex CLI ships an app-server speaking the thread
# protocol. Login/config state is NEVER baked in — operators mount a writable
# CODEX_HOME volume (config.toml + auth/models) at runtime, see
# machine-runtime-entrypoint.sh's LAELIA_CODEX_HOME.
RUN npm install -g --no-audit --no-fund "${CODEX_NPM_SPEC}" \
	&& rm -rf /root/.npm
COPY scripts/docker/machine-runtime-entrypoint.sh /usr/local/bin/machine-runtime-entrypoint
USER laelia
# Sensible defaults for the pod contract; the k8s backend (design §8.2) sets
# them explicitly per pod and may override each one via extraEnv.
ENV HOME=/home/laelia \
	LAELIA_HOME=/data/laelia \
	LAELIA_MACHINE_BIN=/data/bin/laelia-machine
ENTRYPOINT ["machine-runtime-entrypoint"]