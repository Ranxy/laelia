# syntax=docker/dockerfile:1
# Build context must be the repo root (.). Builds the laelia manager image:
# frontend + per-platform machine binaries -> manager-build -> manager.

FROM node:24.12.0-slim AS frontend
WORKDIR /frontend-build
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN npm i -g pnpm@11.10.0 && pnpm i --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM golang:1.26.5-alpine3.23 AS machine-build
ARG VERSION=local
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
# LAELIA_BUILD_PROXY is a custom arg so the proxy only reaches stages that
# declare it; BuildKit would otherwise auto-inject standard proxy args into
# every stage, including the final runtime image.
ARG LAELIA_BUILD_PROXY
ENV VERSION=${VERSION} GIT_COMMIT=${GIT_COMMIT} BUILD_TIME=${BUILD_TIME}
ENV http_proxy=${LAELIA_BUILD_PROXY} https_proxy=${LAELIA_BUILD_PROXY} no_proxy=localhost,127.0.0.1
ENV HTTP_PROXY=${LAELIA_BUILD_PROXY} HTTPS_PROXY=${LAELIA_BUILD_PROXY} NO_PROXY=localhost,127.0.0.1
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# unzip is required by build-pi.sh for the windows pi archive.
RUN apk add --no-cache curl bash gzip unzip
RUN ./scripts/build-embedded-machines.sh /out/embedded_machine

FROM golang:1.26.5-alpine3.23 AS manager-build
ARG VERSION=local
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ARG LAELIA_BUILD_PROXY
ENV BUILD_TIME=${BUILD_TIME}
ENV http_proxy=${LAELIA_BUILD_PROXY} https_proxy=${LAELIA_BUILD_PROXY} no_proxy=localhost,127.0.0.1
ENV HTTP_PROXY=${LAELIA_BUILD_PROXY} HTTPS_PROXY=${LAELIA_BUILD_PROXY} NO_PROXY=localhost,127.0.0.1
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Mirror scripts/build_laelia.sh: start from clean embed directories so stale
# local build artifacts can never leak into the image.
RUN rm -rf ./backend/manager/server/dist ./backend/manager/server/embedded_machine
COPY --from=frontend /frontend-build/dist ./backend/manager/server/dist
COPY --from=machine-build /out/embedded_machine ./backend/manager/server/embedded_machine
RUN CGO_ENABLED=0 go build -tags "embed_frontend embed_machine" -ldflags "-w -s -X github.com/Ranxy/laelia/backend/manager/version.Version=${VERSION} -X github.com/Ranxy/laelia/backend/manager/version.GitCommit=${GIT_COMMIT} -X github.com/Ranxy/laelia/backend/manager/version.BuildTime=${BUILD_TIME}" -p=16 \
	-o /out/laelia ./backend/manager/bin/server/main.go

FROM alpine:3.23 AS manager
ARG VERSION=local
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.version=${VERSION}
LABEL org.opencontainers.image.revision=${GIT_COMMIT}
LABEL org.opencontainers.image.created=${BUILD_TIME}
RUN apk add --no-cache ca-certificates curl \
	&& adduser -D -u 1000 laelia
COPY --from=manager-build /out/laelia /usr/local/bin/laelia
USER laelia
EXPOSE 8181
ENV LAELIA_PG_URL=
ENTRYPOINT ["laelia"]
CMD ["--port", "8181"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
	CMD curl -fsS http://localhost:8181/healthz || exit 1
