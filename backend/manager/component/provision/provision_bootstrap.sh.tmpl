#!/bin/sh
# laelia-machine bootstrap — generated by the laelia manager and carried inside
# a provisioning job. It runs in the pod's init container with:
#   - the machine's data volume mounted at /data (the future LAELIA_HOME mount)
#   - the bootstrap secret (machine.json) mounted read-only at /bootstrap
#
# Image contract: POSIX sh, curl, gzip, sha256sum. Nothing laelia-specific is
# baked into the runtime image — the binary is downloaded from the manager and
# the credential is seeded from the secret, both into the data volume.
set -eu

MANAGER_URL="{{.ManagerURL}}"
TARGET="{{.BinaryTarget}}"
WANT_GZ_SHA256="{{.GzSha256}}"
WANT_SHA256="{{.Sha256}}"
DATA=/data
BIN="$DATA/bin/laelia-machine"
STATE="$DATA/laelia/machine.json"

err() { printf '[bootstrap] error: %s\n' "$1" >&2; exit 1; }
info() { printf '[bootstrap] %s\n' "$1" >&2; }

# 1. Download + verify the machine binary into the data volume. Skipped when a
#    verified binary is already present, so pod restarts stay fast; set
#    LAELIA_FORCE_REDOWNLOAD=true to force a re-download (e.g. after a manager
#    upgrade that swapped the embedded build).
if [ ! -x "$BIN" ] || [ "${LAELIA_FORCE_REDOWNLOAD:-}" = "true" ]; then
  [ -n "$WANT_GZ_SHA256" ] || err "no embedded checksum for target $TARGET"
  command -v curl >/dev/null 2>&1 || err "missing required tool: curl"
  command -v gunzip >/dev/null 2>&1 || err "missing required tool: gunzip"
  command -v sha256sum >/dev/null 2>&1 || err "missing required tool: sha256sum"

  tmp="$(mktemp -d)" || err "failed to create temp dir"
  trap 'rm -rf "$tmp"' EXIT

  info "downloading manifest from $MANAGER_URL"
  curl -fsS "$MANAGER_URL/machine/manifest.json" -o "$tmp/manifest.json" || err "failed to download manifest.json"

  info "downloading machine binary ($TARGET)"
  curl -fsS "$MANAGER_URL/machine/bin/$TARGET" -o "$tmp/machine.gz" || err "failed to download binary for $TARGET"

  printf '%s  %s\n' "$WANT_GZ_SHA256" "$tmp/machine.gz" | sha256sum -c - >/dev/null 2>&1 || err "sha256 mismatch for the downloaded archive"
  info "archive sha256 verified"

  gunzip -c "$tmp/machine.gz" > "$tmp/machine" || err "failed to gunzip the archive"
  printf '%s  %s\n' "$WANT_SHA256" "$tmp/machine" | sha256sum -c - >/dev/null 2>&1 || err "sha256 mismatch for the decompressed binary"
  info "binary sha256 verified"

  mkdir -p "$DATA/bin" || err "failed to create $DATA/bin"
  chmod 0755 "$tmp/machine"
  mv -f "$tmp/machine" "$BIN" || err "failed to install the binary"
  info "installed $BIN"
else
  info "binary already present, skipping download"
fi

# 2. Seed the machine state file on first boot only. The PVC copy is
#    authoritative afterwards (rolling refresh-token renewals persist there);
#    the secret mount is read-only and may go away on later pod specs.
if [ ! -f "$STATE" ] && [ -f /bootstrap/machine.json ]; then
  mkdir -p "$DATA/laelia" || err "failed to create $DATA/laelia"
  cp /bootstrap/machine.json "$STATE" || err "failed to seed machine.json"
  info "seeded machine.json from the bootstrap secret"
elif [ ! -f "$STATE" ]; then
  err "no machine.json on the data volume and no bootstrap secret mounted"
fi

info "bootstrap done"