    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.10.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
